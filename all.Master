<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="all.Master.cs" Inherits="baker_ido.all" %>
<%-- This master page gives the website the same header and menu on many pages --%>
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server" />
    </title>
    <link href="~/MainStyle.css" rel="stylesheet" runat="server" />
    <link href="~/CourseArea.css" rel="stylesheet" runat="server" />
</head>
<body>

<form id="form1" runat="server">

    <div class="top-header">
        <h1>Ido Bakery & Pastry</h1>

        <%-- Main navigation links for moving between the important pages --%>
        <div class="nav-main">
            <a href="/main.aspx">דף ראשי</a>
            <span class="nav-divider">|</span>
            <a href="/About.aspx">אודות</a>
            <span class="nav-divider">|</span>
            <a href="/products.aspx">מתכונים</a>
            <span class="nav-divider">|</span>
            <a href="/Course/CourseSignup.aspx">הרשמה</a>

            <%-- These controls are shown or hidden in all.Master.cs according to Session --%>
            <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Course/Login.aspx">התחברות</asp:HyperLink>

            <asp:HyperLink ID="lnkCourseArea" runat="server" NavigateUrl="~/Course/CourseArea.aspx" Visible="false">אזור הקורס</asp:HyperLink>

            <span class="nav-divider">|</span>
            <a href="/Admin/Users.aspx">ניהול</a>

            <asp:Button ID="btnLogout" runat="server" Text="התנתק" OnClick="btnLogout_Click"
                Visible="false" CausesValidation="false" CssClass="logout-button" />
        </div>

        <h2>
            <asp:ContentPlaceHolder ID="PageHeader" runat="server" />
        </h2>
    </div>

    <div class="container">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        
        <div class="site-footer-space">
            <p class="footer-text">© 2026 Ido Bakery & Pastry</p>
        </div>
    </div>

</form>

</body>
</html>
