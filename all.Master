<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="all.Master.cs" Inherits="baker_ido.all" %>
<%-- דף Master זה נותן לאתר אותה כותרת ותפריט בדפים רבים --%>
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server" />
    </title>
    <link href="~/Styles/MainStyle.css" rel="stylesheet" runat="server" />
    <link href="~/Styles/CourseArea.css" rel="stylesheet" runat="server" />
    <%-- גופן עברי מודרני מ-Google Fonts למראה נקי וקליל --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>

<form id="form1" runat="server">

    <div class="top-header">
        <h1>Ido Bakery & Pastry</h1>

        <%-- קישורי ניווט ראשיים למעבר בין הדפים החשובים --%>
        <div class="nav-main">
            <a href="/Pages/main.aspx">דף ראשי</a>
            <a href="/Pages/About.aspx">אודות</a>

            <%-- קישור זה מוצג רק למשתמש מחובר (נשלט ב-all.Master.cs לפי ה-Session) --%>
            <asp:HyperLink ID="lnkCourseArea" runat="server" NavigateUrl="~/Course/CourseArea.aspx" Visible="false">אזור הקורס</asp:HyperLink>

            <a href="/Admin/Users.aspx">ניהול</a>
        </div>
    </div>

    <div class="container">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        
        <div class="site-footer-space">
            <p class="footer-text">© 2026 Ido Bakery & Pastry</p>
        </div>
    </div>

</form>

</body>
</html>
